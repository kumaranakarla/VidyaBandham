# Copy this file to .env and change the secret before any real use.
JWT_SECRET=change-this-to-a-random-string
PORT=4000

# Razorpay — TET 2026 subscription paywall. Leaving these unset falls back to
# a non-functional test placeholder (order creation will fail against
# Razorpay's real API), so for local testing sign up for a free Razorpay
# account and paste your own TEST-mode keys here. Swap for LIVE keys only
# when you're ready to accept real payments — nothing in the code changes.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Admin dashboard login (see /admin, guarded by role === 'admin'). Set your
# own values here before deploying anywhere reachable by anyone but you —
# leaving these unset falls back to a well-known default password, which is
# fine for local testing only. The account is created automatically the
# first time the server starts with no admin user yet.
ADMIN_EMAIL=admin@vidyabandham.com
ADMIN_PASSWORD=change-this-admin-password
